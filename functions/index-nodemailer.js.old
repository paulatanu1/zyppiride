const functions = require("firebase-functions")
const admin = require("firebase-admin")
const nodemailer = require("nodemailer")

admin.initializeApp()
const db = admin.firestore()

// Set via:
// firebase functions:config:set gmail.user="you@gmail.com" gmail.pass="APP_PASSWORD" admin.emails="admin@zyppi.in,developerzyppi@gmail.com"

const gmailUser = functions.config().gmail && functions.config().gmail.user
const gmailPass = functions.config().gmail && functions.config().gmail.pass

let transporter = nullconst functions = require("firebase-functions")
                      const admin = require("firebase-admin")
                      const nodemailer = require("nodemailer")

                      admin.initializeApp()
                      const db = admin.firestore()

                      // Set via:
                      // firebase functions:config:set gmail.user="you@gmail.com" gmail.pass="APP_PASSWORD" admin.emails="admin@zyppi.in,developerzyppi@gmail.com"

                      const gmailUser = functions.config().gmail && functions.config().gmail.user
                      const gmailPass = functions.config().gmail && functions.config().gmail.pass

                      let transporter = null
                      if (gmailUser && gmailPass) {
                        transporter = nodemailer.createTransport({
                          service: "gmail",
                          auth: { user: gmailUser, pass: gmailPass }
                        })
                      }

                      exports.createComplaint = functions.https.onCall(async (data, context) => {
                        const userId = data.userId || "unknown"
                        const subject = data.subject || "General"
                        const description = data.description || ""
                        const priority = data.priority || "Medium"
                        const imageUrl = data.imageUrl || null

                        const now = new Date()
                        const dateStr = now.toISOString().split("T")[0].replace(/-/g, "")
                        const seq = Math.floor(Math.random() * 900) + 100
                        const ticketId = `ZY-${dateStr}-${String(seq)}`

                        const complaintRef = db.collection("complaints").doc()
                        await complaintRef.set({
                          ticketId,
                          userId,
                          subject,
                          description,
                          priority,
                          imageUrl,
                          status: "Pending",
                          createdAt: admin.firestore.FieldValue.serverTimestamp()
                        })

                        if (transporter) {
                          const adminEmails =
                            functions.config().admin && functions.config().admin.emails
                              ? functions.config().admin.emails.split(",")
                              : ["admin@zyppi.in"]
                          const mailOptions = {
                            from: gmailUser,
                            to: adminEmails,
                            subject: `New Support Ticket: ${ticketId} — ${subject}`,
                            text:
                              `Ticket: ${ticketId}\nUser: ${userId}\nPriority: ${priority}\n\n${description}` +
                              (imageUrl ? `\n\nImage: ${imageUrl}` : "")
                          }
                          try {
                            await transporter.sendMail(mailOptions)
                          } catch (err) {
                            console.error("nodemailer error", err)
                          }
                        }

                        return { ticketId }
                      })

if (gmailUser && gmailPass) {
  transporter = nodemailer.createTransport({
    service: "gmail",
    auth: { user: gmailUser, pass: gmailPass }
  })
}

exports.createComplaint = functions.https.onCall(async (data, context) => {
  const userId = data.userId || "unknown"
  const subject = data.subject || "General"
  const description = data.description || ""
  const priority = data.priority || "Medium"
  const imageUrl = data.imageUrl || null

  const now = new Date()
  const dateStr = now.toISOString().split("T")[0].replace(/-/g, "")
  const seq = Math.floor(Math.random() * 900) + 100
  const ticketId = `ZY-${dateStr}-${String(seq)}`

  const complaintRef = db.collection("complaints").doc()
  await complaintRef.set({
    ticketId,
    userId,
    subject,
    description,
    priority,
    imageUrl,
    status: "Pending",
    createdAt: admin.firestore.FieldValue.serverTimestamp()
  })

  if (transporter) {
    const adminEmails =
      functions.config().admin && functions.config().admin.emails
        ? functions.config().admin.emails.split(",")
        : ["admin@zyppi.in"]
    const mailOptions = {
      from: gmailUser,
      to: adminEmails,
      subject: `New Support Ticket: ${ticketId} — ${subject}`,
      text:
        `Ticket: ${ticketId}\nUser: ${userId}\nPriority: ${priority}\n\n${description}` +
        (imageUrl ? `\n\nImage: ${imageUrl}` : "")
    }
    try {
      await transporter.sendMail(mailOptions)
    } catch (err) {
      console.error("nodemailer error", err)
    }
  }

  return { ticketId }
})
